# Browser: Chrome must be launched by the account holder with --remote-debugging-port=9222.
# This service attaches only to that existing, authenticated session. It does not evade challenges.
CDP_ENDPOINT=http://localhost:9222

# Comma-separated platform adapters. Enable only accounts and platforms whose automation terms permit it.
ENABLED_PLATFORMS=ponisha,karlancer,parscoders
AUTO_SUBMIT_BIDS=false
AUTOMATION_ENABLED=false
MAX_JOBS_PER_PLATFORM=20
POLL_INTERVAL_SECONDS=300
AUTOMATION_MIN_DELAY_SECONDS=2.0

# Supported by an OpenAI-compatible chat-completions endpoint. Leave blank to run discovery only.
LLM_API_URL=https://api.example.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=fast-model
LLM_MIN_AUTOMATION_CONFIDENCE=0.92

# A user-operated execution gateway. See docs/executor-contract.md.
# Arena.ai Agent Mode has no documented public job-execution API in the official help as of 2026-09-27,
# so do not point this at an invented Arena endpoint.
ARENA_EXECUTOR_URL=https://executor.example.com/v1/tasks
ARENA_EXECUTOR_TOKEN=
ARENA_EXECUTOR_TIMEOUT_SECONDS=1800
ARENA_EXECUTOR_POLL_SECONDS=5

# GitHub fine-grained PAT: Contents: Read and write; Administration: Read and write if creating repos.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_PRIVATE=false
# Optional: publish to an existing repository instead of creating one project repo per delivery.
GITHUB_DELIVERY_REPOSITORY=
GITHUB_BRANCH=main

DATABASE_PATH=var/pipeline.sqlite3
ARTIFACT_ROOT=artifacts
LOG_LEVEL=INFO

# ---- Web / Control-plane security ----
# Bearer token required for ALL mutating and admin-visible endpoints
# (/api/runtime/stats, /api/runtime/tune, /api/runtime/gc, /api/orders*,
# /api/simulate). Use:  openssl rand -hex 32   to generate one.
# LEAVING THIS EMPTY DISABLES ALL ADMIN ENDPOINTS (fail-closed).
SERVICE_API_KEY=

# Optional Telegram webhook secret (set on webhook registration as
# `secret_token`). When set, /webhook/* requires the
#   X-Telegram-Bot-Api-Secret-Token: <WEBHOOK_SECRET_TOKEN>
# header from Telegram. Generate with: openssl rand -hex 24
WEBHOOK_SECRET_TOKEN=

# Comma-separated CORS origins (empty = no CORS; safe for same-origin reverse
# proxy like Caddy/Nginx). Example: https://bot.example.com,http://localhost:8000
ALLOWED_ORIGINS=
