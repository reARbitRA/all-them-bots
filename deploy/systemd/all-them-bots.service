[Unit]
Description=Fable-Omega Multi-Tenant Bot Fleet Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/runs/all-them-bots
ExecStart=/home/user/runs/all-them-bots/.venv/bin/python run.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10

# Memory & CPU Guardrails
MemoryMax=250M
MemoryHigh=200M
CPUQuota=150%
Nice=-5

# Environment Optimization
EnvironmentFile=-/home/user/runs/all-them-bots/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONOPTIMIZE=2
Environment=MALLOC_TRIM_THRESHOLD_=100000
Environment=APP_PORT=8000

# Light hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
